# ==============================================================================
# AI ContentStudio — Environment Configuration
# ==============================================================================
# Copy to .env and fill in your values. Never commit .env.
# ==============================================================================

# --- Supabase (required) ------------------------------------------------------
# Project URL and the publishable/anon key, from Supabase → Settings → API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# REQUIRED for batch generation. The background worker has no user request to
# borrow credentials from, so without the service_role key every write is
# rejected by RLS and generation cannot save results.
# Supabase → Settings → API → service_role. Server-side only — never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, session tokens are verified locally with HS256 instead of
# a round trip to Supabase on each new token. Supabase → Settings → API → JWT secret.
SUPABASE_JWT_SECRET=

# --- Security (required) ------------------------------------------------------
# Encrypts stored Google AI API keys. Must be at least 32 characters.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Storage ------------------------------------------------------------------
# Where generated media is written. Relative paths resolve against the project
# root. Media binaries live here, never inside database tables.
OUTPUT_DIR=output
UPLOADS_DIR=uploads

# --- Models -------------------------------------------------------------------
DEFAULT_IMAGE_MODEL=gemini-2.5-flash-image
# Used automatically if the Gemini image model is unavailable to your key.
DEFAULT_IMAGEN_MODEL=imagen-4.0-generate-001
# Fallback voice model when Cloud Text-to-Speech is not enabled for the key.
DEFAULT_TTS_MODEL=gemini-2.5-flash-preview-tts
DEFAULT_GEMINI_VOICE=Kore
DEFAULT_VOICE_LANGUAGE=en-US

# --- Video generation ---------------------------------------------------------
# Off by default: Veo needs a paid, allow-listed key. While disabled, video
# tasks are recorded as UNSUPPORTED rather than reported as generated.
VIDEO_GENERATION_ENABLED=false
DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-preview
VIDEO_POLL_INTERVAL=10
VIDEO_POLL_TIMEOUT=900

# --- Generation behaviour -----------------------------------------------------
MAX_CONCURRENT_JOBS=3
# Merge image + voiceover into an MP4 per scene (needs FFmpeg on PATH).
MERGE_ENABLED=true
FFMPEG_PATH=ffmpeg

# --- Timeouts (seconds) -------------------------------------------------------
IMAGE_TIMEOUT=120
AUDIO_TIMEOUT=60
VIDEO_TIMEOUT=180

# --- Retry policy -------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0
# How long a profile is taken out of rotation after the provider reports
# exhausted quota / a rate limit.
QUOTA_COOLDOWN_SECONDS=900
RATE_LIMIT_COOLDOWN_SECONDS=60

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
