# ==============================================================================
# AI Batch Studio — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
SECRET_KEY=change-this-to-a-random-secret-key
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- Database & Auth ---
# Leave empty to use local SQLite. For Supabase Postgres, use:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-string

# --- Google API Profile 1 ---
# Gemini API key from https://aistudio.google.com/
GOOGLE_PROFILE_1_API_KEY=
# Path to Google Cloud service account JSON for Text-to-Speech
GOOGLE_PROFILE_1_TTS_CREDENTIALS=

# --- Google API Profile 2 (optional) ---
GOOGLE_PROFILE_2_API_KEY=
GOOGLE_PROFILE_2_TTS_CREDENTIALS=

# --- Default Model IDs ---
# Image generation model (Gemini-native, replaces deprecated Imagen)
DEFAULT_IMAGE_MODEL=gemini-2.5-flash-image
# Video generation model
DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Text model for prompt/script enhancement
DEFAULT_TEXT_MODEL=gemini-2.5-flash

# --- Generation Defaults ---
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_CONCURRENCY=1
DEFAULT_RETRY_COUNT=3
DEFAULT_VOICE_LANGUAGE=en-US
DEFAULT_VOICE_NAME=
DEFAULT_SPEECH_SPEED=1.0
DEFAULT_SPEECH_PITCH=0.0
DEFAULT_AUDIO_FORMAT=WAV
DEFAULT_SAMPLE_RATE=24000

# --- Limits ---
MAX_UPLOAD_SIZE_MB=50
MAX_PROMPT_LENGTH=5000
MAX_VOICEOVER_LENGTH=10000
MAX_CONCURRENT_JOBS=5

# --- Retry ---
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=60.0
RETRY_MAX_ATTEMPTS=3

# --- Output ---
OUTPUT_DIR=output
