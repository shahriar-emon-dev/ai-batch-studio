{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "backend/**",
        "maxLambdaSize": "50mb"
      }
    },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/output/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/(.+\\.[a-zA-Z0-9]+)", "dest": "/frontend/$1" },
    { "src": "/(.+)", "dest": "/frontend/$1.html" }
  ]
}
